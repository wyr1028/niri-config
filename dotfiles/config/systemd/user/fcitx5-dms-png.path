[Unit]
Description=Watch DMS fcitx5 theme files and regenerate PNG backgrounds
StartLimitIntervalSec=0

[Path]
PathChanged=%h/.local/share/fcitx5/themes/dms/panel.svg
PathChanged=%h/.local/share/fcitx5/themes/dms/highlight.svg
PathChanged=%h/.local/share/fcitx5/themes/dms/theme.conf

[Install]
WantedBy=default.target
